rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Multi-User Household & User Data Architecture (ADR-005, specs/sync/02):
    //
    // 1. Collection: /users/{userId}
    //    Document ID: userId (Firebase Auth UID)
    //    Fields:
    //      - uid: string (optional, 1..128) - must match userId
    //      - email: string | null (optional, <= 256)
    //      - displayName: string | null (optional, <= 100)
    //      - photoURL: string | null (optional, <= 500)
    //      - currentHouseholdId: string (optional, 1..128) - reference to active household
    //      - createdAt: string (optional, <= 50)
    //      - updatedAt: string (required, 10..50)
    //      - isDeleted: bool (optional)
    //      - deletedAt: string (optional, <= 50)
    //
    // 2. Collection: /households/{householdId}
    //    Document ID: householdId (string, 1..128)
    //    Fields:
    //      - id: string (required, 1..128) - must match householdId
    //      - name: string (required, 1..100) - Household display name
    //      - ownerUid: string (required, 1..128) - Creator UID
    //      - members: list of strings (required, 1..50 members) - List of member UIDs
    //      - inviteCode: string (required, 4..20) - Invitation code for joining
    //      - createdAt: string (required, 10..50) - ISO 8601 creation timestamp
    //      - updatedAt: string (required, 10..50) - ISO 8601 update timestamp
    //      - isDeleted: bool (optional)
    //      - deletedAt: string (optional, <= 50)
    //
    // 3. Shared Subcollections under /households/{householdId}/*
    //    (and legacy /users/{userId}/* for backward compatibility):
    //
    //    - transaction / transactions:
    //        id: string (required, 1..128)
    //        amount: number (required if !isDeleted, -1e9..1e9)
    //        date: string (required if !isDeleted, 8..50)
    //        categoryId: string (required if !isDeleted, 1..128)
    //        accountId: string (required if !isDeleted, 1..128)
    //        comment: string (optional, <= 1000)
    //        subcategory: string (optional, <= 128)
    //        householdId: string (optional, 1..128)
    //        authorId: string (optional, 1..128)
    //        authorName: string | null (optional, <= 100)
    //        updatedAt: string (required, 10..50)
    //        isDeleted: bool (optional)
    //        deletedAt: string (optional, <= 50)
    //
    //    - category / categories:
    //        id: string (required, 1..128)
    //        name: string (required if !isDeleted, 1..100)
    //        colorHex: string (required if !isDeleted, 1..25)
    //        icon: string (required if !isDeleted, 1..50)
    //        sortOrder: number (required if !isDeleted)
    //        isHidden: bool (required if !isDeleted)
    //        createdAt: string (required if !isDeleted, 10..50)
    //        updatedAt: string (required, 10..50)
    //        translationKey: string (optional, <= 100)
    //        transactionType: string (optional, 'expense' | 'income')
    //        householdId: string (optional, 1..128)
    //        isDeleted: bool (optional)
    //        deletedAt: string (optional, <= 50)
    //
    //    - subcategory / subcategories:
    //        id: string (required, 1..128)
    //        categoryId: string (required if !isDeleted, 1..128)
    //        name: string (required if !isDeleted, 1..100)
    //        householdId: string (optional, 1..128)
    //        updatedAt: string (required, 10..50)
    //        isDeleted: bool (optional)
    //        deletedAt: string (optional, <= 50)
    //
    //    - budget / budgets:
    //        id: string or number (required)
    //        amount: number (required if !isDeleted, >= 0)
    //        householdId: string (optional, 1..128)
    //        updatedAt: string (required, 10..50)
    //        isDeleted: bool (optional)
    //        deletedAt: string (optional, <= 50)
    //
    //    - categoryBudget / categoryBudgets:
    //        id: string or number (optional, <= 128)
    //        categoryId: string (required if !isDeleted, 1..128)
    //        categoryName: string (required if !isDeleted, 1..100)
    //        amount: number (required if !isDeleted, >= 0)
    //        householdId: string (optional, 1..128)
    //        updatedAt: string (required, 10..50)
    //        isDeleted: bool (optional)
    //        deletedAt: string (optional, <= 50)
    //
    //    - recurringRule / recurringRules:
    //        id: string (required, 1..128)
    //        amount: number (required if !isDeleted, -1e9..1e9)
    //        categoryId: string (required if !isDeleted, 1..128)
    //        accountId: string (required if !isDeleted, 1..128)
    //        dayOfMonth: number (required if !isDeleted, 1..31)
    //        startDate: string (required if !isDeleted, 7..50)
    //        lastGeneratedMonth: string (optional, <= 50)
    //        isActive: bool (required if !isDeleted)
    //        comment: string (optional, <= 1000)
    //        subcategory: string (optional, <= 128)
    //        endDate: string (optional, 7..50)
    //        householdId: string (optional, 1..128)
    //        updatedAt: string (required, 10..50)
    //        isDeleted: bool (optional)
    //        deletedAt: string (optional, <= 50)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() &&
             request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
             (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    function isValidOptionalNullableString(data, field, minLen, maxLen) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    function isValidUpdatedAt(data) {
      return ('updatedAt' in data) &&
             data.updatedAt is string &&
             data.updatedAt.size() >= 10 &&
             data.updatedAt.size() <= 50;
    }

    function isValidSoftDelete(data) {
      return (!('isDeleted' in data) || data.isDeleted is bool) &&
             (!('deletedAt' in data) || (data.deletedAt is string && data.deletedAt.size() >= 10 && data.deletedAt.size() <= 50));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUserDoc(data, userId) {
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'currentHouseholdId', 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt']) &&
             isValidUpdatedAt(data) &&
             isValidSoftDelete(data) &&
             (!('uid' in data) || data.uid == null || data.uid == userId) &&
             isValidOptionalNullableString(data, 'email', 3, 256) &&
             isValidOptionalNullableString(data, 'displayName', 1, 100) &&
             isValidOptionalNullableString(data, 'photoURL', 1, 500) &&
             isValidOptionalString(data, 'currentHouseholdId', 1, 128) &&
             isValidOptionalString(data, 'createdAt', 10, 50);
    }

    function isValidHousehold(data, householdId) {
      return data.keys().hasOnly(['id', 'name', 'ownerUid', 'members', 'inviteCode', 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt']) &&
             isValidUpdatedAt(data) &&
             isValidSoftDelete(data) &&
             (data.id is string && data.id == householdId) &&
             (data.name is string && data.name.size() > 0 && data.name.size() <= 100) &&
             (data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128) &&
             (data.members is list && data.members.size() > 0 && data.members.size() <= 50) &&
             (data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 20) &&
             (data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 50);
    }

    function isValidTransaction(data) {
      return data.keys().hasOnly(['id', 'amount', 'date', 'categoryId', 'accountId', 'comment', 'subcategory', 'householdId', 'authorId', 'authorName', 'updatedAt', 'isDeleted', 'deletedAt']) &&
             isValidUpdatedAt(data) &&
             isValidSoftDelete(data) &&
             (data.id is string && data.id.size() > 0 && data.id.size() <= 128) &&
             (!('amount' in data) || (data.amount is number && data.amount >= -1000000000 && data.amount <= 1000000000)) &&
             (!('date' in data) || (data.date is string && data.date.size() >= 8 && data.date.size() <= 50)) &&
             (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128)) &&
             (!('accountId' in data) || (data.accountId is string && data.accountId.size() > 0 && data.accountId.size() <= 128)) &&
             isValidOptionalString(data, 'comment', 0, 1000) &&
             isValidOptionalString(data, 'subcategory', 0, 128) &&
             isValidOptionalString(data, 'householdId', 1, 128) &&
             isValidOptionalString(data, 'authorId', 1, 128) &&
             isValidOptionalNullableString(data, 'authorName', 0, 100) &&
             (data.get('isDeleted', false) == true || data.keys().hasAll(['id', 'amount', 'date', 'categoryId', 'accountId', 'updatedAt']));
    }

    function isValidCategory(data) {
      return data.keys().hasOnly(['id', 'name', 'colorHex', 'icon', 'sortOrder', 'isHidden', 'createdAt', 'updatedAt', 'translationKey', 'transactionType', 'householdId', 'isDeleted', 'deletedAt']) &&
             isValidUpdatedAt(data) &&
             isValidSoftDelete(data) &&
             (data.id is string && data.id.size() > 0 && data.id.size() <= 128) &&
             (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
             (!('colorHex' in data) || (data.colorHex is string && data.colorHex.size() > 0 && data.colorHex.size() <= 25)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() > 0 && data.icon.size() <= 50)) &&
             (!('sortOrder' in data) || data.sortOrder is number) &&
             (!('isHidden' in data) || data.isHidden is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 50)) &&
             isValidOptionalString(data, 'translationKey', 0, 100) &&
             (!('transactionType' in data) || data.transactionType in ['expense', 'income']) &&
             isValidOptionalString(data, 'householdId', 1, 128) &&
             (data.get('isDeleted', false) == true || data.keys().hasAll(['id', 'name', 'colorHex', 'icon', 'sortOrder', 'isHidden', 'createdAt', 'updatedAt']));
    }

    function isValidSubcategory(data) {
      return data.keys().hasOnly(['id', 'categoryId', 'name', 'householdId', 'updatedAt', 'isDeleted', 'deletedAt']) &&
             isValidUpdatedAt(data) &&
             isValidSoftDelete(data) &&
             (data.id is string && data.id.size() > 0 && data.id.size() <= 128) &&
             (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128)) &&
             (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
             isValidOptionalString(data, 'householdId', 1, 128) &&
             (data.get('isDeleted', false) == true || data.keys().hasAll(['id', 'categoryId', 'name', 'updatedAt']));
    }

    function isValidBudget(data) {
      return data.keys().hasOnly(['id', 'amount', 'householdId', 'updatedAt', 'isDeleted', 'deletedAt']) &&
             isValidUpdatedAt(data) &&
             isValidSoftDelete(data) &&
             ((data.id is string && data.id.size() > 0 && data.id.size() <= 128) || data.id is number) &&
             (!('amount' in data) || (data.amount is number && data.amount >= 0 && data.amount <= 1000000000)) &&
             isValidOptionalString(data, 'householdId', 1, 128) &&
             (data.get('isDeleted', false) == true || data.keys().hasAll(['id', 'amount', 'updatedAt']));
    }

    function isValidCategoryBudget(data) {
      return data.keys().hasOnly(['id', 'categoryId', 'categoryName', 'amount', 'householdId', 'updatedAt', 'isDeleted', 'deletedAt']) &&
             isValidUpdatedAt(data) &&
             isValidSoftDelete(data) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128) || data.id is number) &&
             (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128)) &&
             (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() > 0 && data.categoryName.size() <= 100)) &&
             (!('amount' in data) || (data.amount is number && data.amount >= 0 && data.amount <= 1000000000)) &&
             isValidOptionalString(data, 'householdId', 1, 128) &&
             (data.get('isDeleted', false) == true || data.keys().hasAll(['categoryId', 'categoryName', 'amount', 'updatedAt']));
    }

    function isValidRecurringRule(data) {
      return data.keys().hasOnly(['id', 'amount', 'categoryId', 'accountId', 'dayOfMonth', 'startDate', 'lastGeneratedMonth', 'isActive', 'comment', 'subcategory', 'endDate', 'householdId', 'updatedAt', 'isDeleted', 'deletedAt']) &&
             isValidUpdatedAt(data) &&
             isValidSoftDelete(data) &&
             (data.id is string && data.id.size() > 0 && data.id.size() <= 128) &&
             (!('amount' in data) || (data.amount is number && data.amount >= -1000000000 && data.amount <= 1000000000)) &&
             (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128)) &&
             (!('accountId' in data) || (data.accountId is string && data.accountId.size() > 0 && data.accountId.size() <= 128)) &&
             (!('dayOfMonth' in data) || (data.dayOfMonth is number && data.dayOfMonth >= 1 && data.dayOfMonth <= 31)) &&
             (!('startDate' in data) || (data.startDate is string && data.startDate.size() >= 7 && data.startDate.size() <= 50)) &&
             isValidOptionalString(data, 'lastGeneratedMonth', 0, 50) &&
             (!('isActive' in data) || data.isActive is bool) &&
             isValidOptionalString(data, 'comment', 0, 1000) &&
             isValidOptionalString(data, 'subcategory', 0, 128) &&
             isValidOptionalString(data, 'endDate', 7, 50) &&
             isValidOptionalString(data, 'householdId', 1, 128) &&
             (data.get('isDeleted', false) == true || data.keys().hasAll(['id', 'amount', 'categoryId', 'accountId', 'dayOfMonth', 'startDate', 'isActive', 'updatedAt']));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // ---------------------------------------------------------------
    // 1. User Profiles & Legacy Subcollections (/users/{userId})
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserDoc(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserDoc(request.resource.data, userId)
                    && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isOwner(userId);

      // Transactions subcollection (singular & plural)
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(request.resource.data);
        allow update: if isOwner(userId) && isValidTransaction(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }
      match /transaction/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(request.resource.data);
        allow update: if isOwner(userId) && isValidTransaction(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }

      // Categories subcollection (singular & plural)
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategory(request.resource.data);
        allow update: if isOwner(userId) && isValidCategory(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
                      && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }
      match /category/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategory(request.resource.data);
        allow update: if isOwner(userId) && isValidCategory(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
                      && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // Subcategories subcollection (singular & plural)
      match /subcategories/{subcategoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSubcategory(request.resource.data);
        allow update: if isOwner(userId) && isValidSubcategory(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }
      match /subcategory/{subcategoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSubcategory(request.resource.data);
        allow update: if isOwner(userId) && isValidSubcategory(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }

      // Budget subcollection (singular & plural)
      match /budget/{budgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBudget(request.resource.data);
        allow update: if isOwner(userId) && isValidBudget(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBudget(request.resource.data);
        allow update: if isOwner(userId) && isValidBudget(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }

      // CategoryBudget subcollection (singular & plural)
      match /categoryBudget/{categoryBudgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategoryBudget(request.resource.data);
        allow update: if isOwner(userId) && isValidCategoryBudget(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }
      match /categoryBudgets/{categoryBudgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategoryBudget(request.resource.data);
        allow update: if isOwner(userId) && isValidCategoryBudget(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }

      // RecurringRules subcollection (singular & plural)
      match /recurringRule/{ruleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRecurringRule(request.resource.data);
        allow update: if isOwner(userId) && isValidRecurringRule(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }
      match /recurringRules/{ruleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRecurringRule(request.resource.data);
        allow update: if isOwner(userId) && isValidRecurringRule(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------
    // 2. Household Management & Shared Subcollections (/households/{householdId})
    // ---------------------------------------------------------------
    match /households/{householdId} {
      // Read allowed for members or when searching by inviteCode (or non-existent check during init)
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.members ||
        (resource.data.inviteCode is string && resource.data.inviteCode.size() > 0)
      );

      // Authenticated user creates a household, must be owner and included in members
      allow create: if isAuthenticated() &&
                    request.auth.uid == request.resource.data.ownerUid &&
                    request.auth.uid in request.resource.data.members &&
                    isValidHousehold(request.resource.data, householdId);

      // Update allowed for existing member OR new user joining by adding themselves to members
      allow update: if isAuthenticated() &&
                    isValidHousehold(request.resource.data, householdId) &&
                    (
                      // Existing member updating the household
                      (request.auth.uid in resource.data.members &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.ownerUid == resource.data.ownerUid &&
                       request.resource.data.createdAt == resource.data.createdAt)
                      ||
                      // New user joining via invite code by appending themselves to members
                      (request.auth.uid in request.resource.data.members &&
                       request.resource.data.members.hasAll(resource.data.members) &&
                       request.resource.data.members.size() == resource.data.members.size() + 1 &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.name == resource.data.name &&
                       request.resource.data.ownerUid == resource.data.ownerUid &&
                       request.resource.data.inviteCode == resource.data.inviteCode &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false))
                    );

      // Only the household owner can delete the household document
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerUid;

      // Transactions subcollection under household (singular & plural)
      match /transaction/{transactionId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidTransaction(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidTransaction(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }
      match /transactions/{transactionId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidTransaction(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidTransaction(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }

      // Categories subcollection under household (singular & plural)
      match /category/{categoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidCategory(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidCategory(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
                      && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isHouseholdMember(householdId);
      }
      match /categories/{categoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidCategory(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidCategory(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
                      && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isHouseholdMember(householdId);
      }

      // Subcategories subcollection under household (singular & plural)
      match /subcategory/{subcategoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidSubcategory(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidSubcategory(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }
      match /subcategories/{subcategoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidSubcategory(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidSubcategory(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }

      // Budget subcollection under household (singular & plural)
      match /budget/{budgetId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidBudget(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidBudget(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }
      match /budgets/{budgetId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidBudget(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidBudget(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }

      // CategoryBudget subcollection under household (singular & plural)
      match /categoryBudget/{categoryBudgetId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidCategoryBudget(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidCategoryBudget(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }
      match /categoryBudgets/{categoryBudgetId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidCategoryBudget(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidCategoryBudget(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }

      // RecurringRules subcollection under household (singular & plural)
      match /recurringRule/{ruleId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidRecurringRule(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidRecurringRule(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }
      match /recurringRules/{ruleId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && isValidRecurringRule(request.resource.data);
        allow update: if isHouseholdMember(householdId) && isValidRecurringRule(request.resource.data)
                      && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
        allow delete: if isHouseholdMember(householdId);
      }
    }

    // ===============================================================
    // Default Deny Rule
    // ===============================================================
    // Deny all reads and writes for any collection or path not explicitly permitted above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
