{
  "name": "budget-fort",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "root": "apps/budget-fort",
  "sourceRoot": "apps/budget-fort/src",
  "i18n": {
    "sourceLocale": "pl",
    "locales": {
      "en": "apps/budget-fort/src/locale/messages.en.xlf"
    }
  },
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/budget-fort",
        "deleteOutputPath": false,
        "browser": "apps/budget-fort/src/main.ts",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/budget-fort/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/budget-fort/public"
          }
        ],
        "styles": ["apps/budget-fort/src/styles.scss"],
        "optimization": {
          "fonts": false
        },
        "localize": ["pl"]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/budget-fort/src/environments/environment.ts",
              "with": "apps/budget-fort/src/environments/environment.prod.ts"
            }
          ],
          "localize": ["pl"],
          "baseHref": "/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "production-en": {
          "fileReplacements": [
            {
              "replace": "apps/budget-fort/src/environments/environment.ts",
              "with": "apps/budget-fort/src/environments/environment.prod.ts"
            }
          ],
          "localize": ["en"],
          "baseHref": "/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/budget-fort/src/environments/environment.ts",
              "with": "apps/budget-fort/src/environments/environment.dev.ts"
            }
          ],
          "localize": ["pl"],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "development-en": {
          "fileReplacements": [
            {
              "replace": "apps/budget-fort/src/environments/environment.ts",
              "with": "apps/budget-fort/src/environments/environment.dev.ts"
            }
          ],
          "localize": ["en"],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "budget-fort:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "budget-fort:build:production"
        },
        "production-en": {
          "buildTarget": "budget-fort:build:production-en"
        },
        "development": {
          "buildTarget": "budget-fort:build:development"
        },
        "en": {
          "buildTarget": "budget-fort:build:development-en"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "budget-fort:build",
        "port": 4200,
        "staticFilePath": "dist/budget-fort/browser",
        "spa": true
      }
    }
  }
}
