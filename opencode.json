{
  "mcp": {
    "servers": {
      "nx-mcp": {
        "type": "local",
        "command": ["npx", "-y", "nx-mcp@latest"],
        "enabled": true
      },
      "angular-cli": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@angular/cli",
          "mcp"
        ]
      }
    }
  }
}
