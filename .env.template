# =============================================================================
# Budget Fort — Firebase Environment Variables
# =============================================================================
# Skopiuj ten plik jako .env i uzupełnij wartościami.
#   cp .env.template .env
#
# Uwaga: .env jest w .gitignore — NIGDY nie commituj prawdziwych kluczy.

# ---------------------------------------------------------------------------
# Firebase Authentication (CI/CD)
# ---------------------------------------------------------------------------

# CI token do Firebase CLI (nieinteraktywne logowanie).
# Wygeneruj poleceniem:  firebase login:ci
# Działa jako alternatywa dla interaktywnego `firebase login`.
FIREBASE_TOKEN=your_firebase_ci_token_here

# ---------------------------------------------------------------------------
# Firebase Project
# ---------------------------------------------------------------------------

# ID projektu Firebase (znajdziesz w Firebase Console → Project settings).
# Używane przez firebase-tools do wskazania docelowego projektu.
FIREBASE_PROJECT_ID=budget-fort-pwa

# ---------------------------------------------------------------------------
# Firebase SDK (klient — NIE są to sekrety!)
# ---------------------------------------------------------------------------
# Konfiguracja Firebase SDK znajduje się w:
#   apps/budget-fort/src/environments/environment.ts
#
# UWAGA: apiKey Firebase NIE jest sekretem — to publiczny identyfikator
# projektu w Google Cloud. Bezpieczeństwo danych zapewniają Firebase Security
# Rules, a nie ukrywanie klucza. Więcej:
# https://firebase.google.com/docs/projects/api-keys

# ---------------------------------------------------------------------------
# Opcjonalne — Firebase Hosting
# ---------------------------------------------------------------------------

# Alias hostingu (np. "production", "staging") — jeśli używasz wielu targetów.
# FIREBASE_HOSTING_TARGET=production

# ---------------------------------------------------------------------------
# Opcjonalne — Service Account (dla zaawansowanych, np. CI/CD pipelines)
# ---------------------------------------------------------------------------

# Ścieżka do klucza service account (JSON) — alternatywa dla FIREBASE_TOKEN.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json