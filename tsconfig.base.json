{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@ui-transaction": [
        "./libs/transaction/src/lib/ui-transaction/src/index.ts"
      ],
      "@data-access-transaction": [
        "./libs/transaction/src/lib/data-access-transaction/src/index.ts"
      ],
      "@feature-transaction": [
        "./libs/transaction/src/lib/feature-transaction/src/index.ts"
      ],
      "local-db": [
        "./libs/shared/local-db/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
