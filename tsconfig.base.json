{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@ui-transaction": ["./libs/transaction/src/lib/ui-transaction/src/index.ts"],
      "@data-access-transaction": [
        "./libs/transaction/src/lib/data-access-transaction/src/index.ts"
      ],
      "@feature-transaction": ["./libs/transaction/src/lib/feature-transaction/src/index.ts"],
      "local-db": ["./libs/shared/local-db/src/index.ts"],
      "@currency": ["./libs/shared/currency/src/index.ts"],
      "@data-access-budget": ["./libs/budget/data-access-budget/src/index.ts"],
      "@ui-budget": ["./libs/budget/ui-budget/src/index.ts"],
      "@feature-budget": ["./libs/budget/feature-budget/src/index.ts"],
      "@data-access-auth": ["./libs/auth/data-access-auth/src/index.ts"],
      "@ui-auth": ["./libs/auth/ui-auth/src/index.ts"],
      "@feature-auth": ["./libs/auth/feature-auth/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
